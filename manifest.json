{
  "manifest_version": 3,
  "name": "Why Did You Click?",
  "version": "1.1.0",
  "description": "Inspiration Board + Content Lab for YouTube creators.",
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": ["https://www.youtube.com/*", "https://api.anthropic.com/*", "http://localhost:3000/*"],
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Why Did You Click?"
  }
}
