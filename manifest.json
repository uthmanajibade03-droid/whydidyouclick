{
  "manifest_version": 3,
  "name": "Why Did You Click?",
  "version": "1.0.0",
  "description": "Save reasons why you clicked YouTube videos — by title, thumbnail, or both.",
  "permissions": ["storage", "sidePanel"],
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Inspiration Board"
  }
}
